@inject PortfolioApiService ApiService
@inject IJSRuntime JS

<div class="modal fade @(IsVisible ? "show d-block" : "")" tabindex="-1" style="background-color: rgba(0,0,0,0.7);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@(SymbolSelected ? "Añadir compra" : "Nueva inversión")</h5>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                @if (!SymbolSelected)
                {
                    <div class="btn-group w-100 mb-3" role="group">
                        <button type="button" class="btn @(IsNewMode ? "btn-primary" : "btn-outline-primary")" @onclick="() => SelectMode(true)">Nueva inversión</button>
                        <button type="button" class="btn @(!IsNewMode ? "btn-primary" : "btn-outline-primary")" @onclick="() => SelectMode(false)">Añadir a existente</button>
                    </div>

                    @if (IsNewMode)
                    {
                        <div class="mb-3">
                            <label class="form-label">Buscar símbolo</label>
                            <div class="input-group">
                                <input type="text" class="form-control" @bind="SearchQuery" @bind:event="oninput" placeholder="p. ej. AAPL, MSCIWORLD, BABA" />
                                <button class="btn btn-primary" @onclick="Search" disabled="@IsSearching">
                                    @if (IsSearching)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        <span>Buscar</span>
                                    }
                                </button>
                            </div>
                            <small class="text-muted">También puedes buscar por ISIN.</small>
                        </div>

                        @if (SearchResults != null)
                        {
                            <div class="list-group">
                                @foreach (var result in SearchResults)
                                {
                                    <button class="list-group-item list-group-item-action" @onclick="() => SelectSymbol(result)">
                                        <strong>@result.Symbol</strong> - @result.Name
                                        <small class="text-muted">(@result.Type)</small>
                                    </button>
                                }
                            </div>
                        }

                        @if (NoResults)
                        {
                            <div class="alert alert-warning mt-3">No se encontraron resultados para "@SearchQuery"</div>
                        }
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Inversión existente</label>
                            <select class="form-select" @bind="SelectedExistingItemId">
                                <option value="">Seleccionar inversión...</option>
                                @foreach (var existing in ExistingItems)
                                {
                                    <option value="@existing.Id">@existing.Symbol - @existing.Name</option>
                                }
                            </select>
                        </div>

                        @if (SelectedExistingItem != null)
                        {
                            <button class="btn btn-primary w-100" @onclick="SelectExisting">
                                Continuar con @SelectedExistingItem.Symbol
                            </button>
                        }
                    }
                }
                else
                {
                    <div class="alert alert-info d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@SelectedSymbol?.Symbol</strong> - @SelectedSymbol?.Name
                        </div>
                        <button class="btn btn-sm btn-link" @onclick="ChangeSymbol">Cambiar</button>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Participaciones</label>
                            <input type="number" class="form-control" @bind="Shares" step="0.0001" min="0.0001" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Precio de compra</label>
                            <div class="input-group">
                                <span class="input-group-text">€</span>
                                <input type="number" class="form-control" @bind="PurchasePrice" step="0.0001" min="0.01" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Fecha de compra (opcional)</label>
                            <input type="date" class="form-control" @bind="PurchaseDate" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Comisión (€)</label>
                            <div class="input-group">
                                <span class="input-group-text">€</span>
                                <input type="number" class="form-control" @bind="Commission" step="0.01" min="0" />
                            </div>
                        </div>
                    </div>

                    @if (IsFund)
                    {
                        <div class="alert alert-secondary">
                            <h6 class="mb-2">Mapeo de símbolo de fondo</h6>
                            <div class="mb-2">
                                <label class="form-label">Símbolo alternativo (opcional)</label>
                                <input type="text" class="form-control" @bind="AlternativeSymbol" maxlength="50" placeholder="p. ej. LU0840158819.EUFUND" />
                                <small class="text-muted">Algunos fondos cotizan con un símbolo distinto en proveedores como EOD.</small>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="UseAlternativeSymbol" id="useAltSymbolAdd" />
                                <label class="form-check-label" for="useAltSymbolAdd">
                                    Usar símbolo alternativo para precios
                                </label>
                            </div>
                        </div>
                    }

                    @if (HasError)
                    {
                        <div class="alert alert-danger">@ErrorMessage</div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="Close">Cancelar</button>
                @if (SymbolSelected)
                {
                    <button type="button" class="btn btn-primary" @onclick="Save" disabled="@IsSaving">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <span>Añadir inversión</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter]
    public Guid UserId { get; set; }

    [Parameter]
    public List<PortfolioItemDto> ExistingItems { get; set; } = [];

    [Parameter]
    public Guid? PreselectedExistingItemId { get; set; }

    [Parameter]
    public EventCallback OnItemAdded { get; set; }

    private bool SymbolSelected => SelectedSymbol != null;
    private string SearchQuery { get; set; } = "";
    private bool IsSearching { get; set; }
    private bool NoResults { get; set; }
    private List<SearchResultDto>? SearchResults { get; set; }
    private SearchResultDto? SelectedSymbol { get; set; }
    private string SelectedExistingItemId { get; set; } = "";
    private PortfolioItemDto? SelectedExistingItem => ExistingItems.FirstOrDefault(i => i.Id.ToString() == SelectedExistingItemId);
    private bool IsNewMode { get; set; } = true;
    private decimal Shares { get; set; }
    private decimal PurchasePrice { get; set; }
    private DateTime? PurchaseDate { get; set; }
    private decimal Commission { get; set; }
    private string? AlternativeSymbol { get; set; }
    private bool UseAlternativeSymbol { get; set; }
    private bool IsSaving { get; set; }
    private bool HasError { get; set; }
    private string ErrorMessage { get; set; } = "";

    private bool IsFund => SelectedSymbol?.Type.Equals("Fund", StringComparison.OrdinalIgnoreCase) == true;

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(SearchQuery))
            return;

        IsSearching = true;
        NoResults = false;
        SearchResults = null;

        try
        {
            var result = await ApiService.SearchSymbolAsync(SearchQuery);
            if (result != null)
            {
                SearchResults = [result];
            }
            else
            {
                NoResults = true;
            }
        }
        finally
        {
            IsSearching = false;
        }
    }

    private void SelectSymbol(SearchResultDto result)
    {
        SelectedSymbol = result;
        SearchResults = null;
        SearchQuery = "";
        NoResults = false;
    }

    private void ChangeSymbol()
    {
        SelectedSymbol = null;
        SearchQuery = "";
    }

    private void SelectMode(bool isNew)
    {
        IsNewMode = isNew;
        HasError = false;
        ErrorMessage = "";
    }

    private void SelectExisting()
    {
        var existing = SelectedExistingItem;
        if (existing == null)
            return;

        SelectedSymbol = new SearchResultDto
        {
            Symbol = existing.Symbol,
            Name = existing.Name,
            Type = existing.Type
        };
        AlternativeSymbol = existing.AlternativeSymbol;
        UseAlternativeSymbol = existing.UseAlternativeSymbol;
    }

    public override async Task SetParametersAsync(ParameterView parameters)
    {
        await base.SetParametersAsync(parameters);

        if (PreselectedExistingItemId.HasValue && PreselectedExistingItemId.Value != Guid.Empty)
        {
            IsNewMode = false;
            SelectedExistingItemId = PreselectedExistingItemId.Value.ToString();
        }
    }

    private async Task Save()
    {
        if (SelectedSymbol == null || Shares <= 0 || PurchasePrice <= 0)
        {
            HasError = true;
            ErrorMessage = "Rellena todos los campos obligatorios.";
            return;
        }

        IsSaving = true;
        HasError = false;

        try
        {
            var request = new CreatePortfolioItemRequest
            {
                UserId = UserId,
                Symbol = SelectedSymbol.Symbol,
                Name = SelectedSymbol.Name,
                Type = SelectedSymbol.Type,
                Shares = Shares,
                PurchasePrice = PurchasePrice,
                PurchaseDate = PurchaseDate,
                Commission = Commission,
                AlternativeSymbol = AlternativeSymbol,
                UseAlternativeSymbol = UseAlternativeSymbol
            };

            var result = await ApiService.AddItemAsync(request);
            if (result != null)
            {
                await OnItemAdded.InvokeAsync();
                await Close();
            }
            else
            {
                HasError = true;
                ErrorMessage = "No se pudo añadir la inversión.";
            }
        }
        catch (Exception ex)
        {
            HasError = true;
            ErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task Close()
    {
        SearchQuery = "";
        IsSearching = false;
        NoResults = false;
        SearchResults = null;
        SelectedSymbol = null;
        SelectedExistingItemId = "";
        IsNewMode = true;
        Shares = 0;
        PurchasePrice = 0;
        PurchaseDate = null;
        Commission = 0;
        AlternativeSymbol = null;
        UseAlternativeSymbol = false;
        IsSaving = false;
        HasError = false;
        ErrorMessage = "";
        await IsVisibleChanged.InvokeAsync(false);
    }
}
