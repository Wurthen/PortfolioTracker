@inject PortfolioApiService ApiService
@inject ILogger<EditItemDialog> Logger

<div class="modal fade @(IsVisible ? "show d-block" : "")" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="editItemModalTitle" style="background-color: rgba(0,0,0,0.7);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editItemModalTitle">Editar inversión</h5>
                <button type="button" class="btn-close" aria-label="Cerrar" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-secondary d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@Item?.Symbol</strong>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input type="text" class="form-control" @bind="Name" maxlength="200" placeholder="p. ej. Amundi Index MSCI World SRI" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Participaciones</label>
                        <input type="number" class="form-control" @bind="Shares" step="0.0001" min="0.0001" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Precio de compra</label>
                        <div class="input-group">
                            <span class="input-group-text">€</span>
                            <input type="number" class="form-control" @bind="PurchasePrice" step="0.0001" min="0.01" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Fecha de compra (opcional)</label>
                        <input type="date" class="form-control" @bind="PurchaseDate" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Comisión (€)</label>
                        <div class="input-group">
                            <span class="input-group-text">€</span>
                            <input type="number" class="form-control" @bind="Commission" step="0.01" min="0" />
                        </div>
                    </div>
                </div>

                @if (IsFund)
                {
                    <div class="alert alert-secondary">
                        <h6 class="mb-2">Mapeo de símbolo de fondo</h6>
                        <div class="mb-2">
                            <label class="form-label">Símbolo alternativo (opcional)</label>
                            <input type="text" class="form-control" @bind="AlternativeSymbol" maxlength="50" placeholder="p. ej. LU0840158819.EUFUND" />
                            <small class="text-muted">Algunos fondos cotizan con un símbolo distinto en proveedores como EOD.</small>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="UseAlternativeSymbol" id="useAltSymbol" />
                            <label class="form-check-label" for="useAltSymbol">
                                Usar símbolo alternativo para precios
                            </label>
                        </div>
                    </div>
                }

                @if (HasError)
                {
                    <div class="alert alert-danger">@ErrorMessage</div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="Close">Cancelar</button>
                <button type="button" class="btn btn-primary" @onclick="Save" disabled="@IsSaving">
                    @if (IsSaving)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <span>Guardar cambios</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter]
    public PortfolioItemDto? Item { get; set; }

    [Parameter]
    public Guid UserId { get; set; }

    [Parameter]
    public EventCallback OnItemUpdated { get; set; }

    private decimal Shares { get; set; }
    private decimal PurchasePrice { get; set; }
    private DateTime? PurchaseDate { get; set; }
    private decimal Commission { get; set; }
    private string Name { get; set; } = "";
    private string? AlternativeSymbol { get; set; }
    private bool UseAlternativeSymbol { get; set; }
    private bool IsSaving { get; set; }
    private bool HasError { get; set; }
    private string ErrorMessage { get; set; } = "";

    private Guid? _lastItemId;
    private bool IsFund => string.Equals(Item?.Type, "Fund", StringComparison.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        if (Item != null && Item.Id != _lastItemId)
        {
            _lastItemId = Item.Id;
            Shares = Item.Shares;
            PurchasePrice = Item.PurchasePrice;
            PurchaseDate = Item.PurchaseDate;
            Commission = Item.Commission;
            Name = Item.Name;
            AlternativeSymbol = Item.AlternativeSymbol;
            UseAlternativeSymbol = Item.UseAlternativeSymbol;
        }
    }

    private async Task Save()
    {
        if (Item == null || Shares <= 0 || PurchasePrice <= 0)
        {
            HasError = true;
            ErrorMessage = "Rellena todos los campos obligatorios.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Name))
        {
            HasError = true;
            ErrorMessage = "El nombre es obligatorio.";
            return;
        }

        IsSaving = true;
        HasError = false;

        try
        {
            var request = new UpdatePortfolioItemRequest
            {
                Shares = Shares,
                PurchasePrice = PurchasePrice,
                PurchaseDate = PurchaseDate,
                Commission = Commission,
                Name = Name,
                AlternativeSymbol = AlternativeSymbol,
                UseAlternativeSymbol = UseAlternativeSymbol
            };

            var result = await ApiService.UpdateItemAsync(Item.Id, UserId, request);
            if (result != null)
            {
                await OnItemUpdated.InvokeAsync();
                await Close();
            }
            else
            {
                HasError = true;
                ErrorMessage = "No se pudo actualizar la inversión.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating item {ItemId}", Item.Id);
            HasError = true;
            ErrorMessage = "No se pudo actualizar la inversión. Inténtalo de nuevo.";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task Close()
    {
        Shares = 0;
        PurchasePrice = 0;
        PurchaseDate = null;
        Commission = 0;
        Name = "";
        AlternativeSymbol = null;
        UseAlternativeSymbol = false;
        _lastItemId = null;
        IsSaving = false;
        HasError = false;
        ErrorMessage = "";
        await IsVisibleChanged.InvokeAsync(false);
    }
}
