@inject PortfolioApiService ApiService

<div class="modal fade @(IsVisible ? "show d-block" : "")" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Investment</h5>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-secondary d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@Item?.Symbol</strong>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input type="text" class="form-control" @bind="Name" maxlength="200" placeholder="e.g. Amundi Index MSCI World SRI" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Shares</label>
                    <input type="number" class="form-control" @bind="Shares" step="0.0001" min="0.0001" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Purchase Price (per share)</label>
                    <div class="input-group">
                        <span class="input-group-text">€</span>
                        <input type="number" class="form-control" @bind="PurchasePrice" step="0.0001" min="0.01" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Purchase Date (optional)</label>
                    <input type="date" class="form-control" @bind="PurchaseDate" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Commission (€)</label>
                    <div class="input-group">
                        <span class="input-group-text">€</span>
                        <input type="number" class="form-control" @bind="Commission" step="0.01" min="0" />
                    </div>
                </div>

                @if (IsFund)
                {
                    <div class="alert alert-light border">
                        <h6 class="mb-2">Fund Symbol Mapping</h6>
                        <div class="mb-2">
                            <label class="form-label">Alternative Symbol (optional)</label>
                            <input type="text" class="form-control" @bind="AlternativeSymbol" maxlength="50" placeholder="e.g. LU0840158819.EUFUND" />
                            <small class="text-muted">Some funds are listed under a different symbol on data providers like EOD.</small>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="UseAlternativeSymbol" id="useAltSymbol" />
                            <label class="form-check-label" for="useAltSymbol">
                                Use alternative symbol for price lookup
                            </label>
                        </div>
                    </div>
                }

                @if (HasError)
                {
                    <div class="alert alert-danger">@ErrorMessage</div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="Close">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="Save" disabled="@IsSaving">
                    @if (IsSaving)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter]
    public PortfolioItemDto? Item { get; set; }

    [Parameter]
    public Guid UserId { get; set; }

    [Parameter]
    public EventCallback OnItemUpdated { get; set; }

    private decimal Shares { get; set; }
    private decimal PurchasePrice { get; set; }
    private DateTime? PurchaseDate { get; set; }
    private decimal Commission { get; set; }
    private string Name { get; set; } = "";
    private string? AlternativeSymbol { get; set; }
    private bool UseAlternativeSymbol { get; set; }
    private bool IsSaving { get; set; }
    private bool HasError { get; set; }
    private string ErrorMessage { get; set; } = "";

    private Guid? _lastItemId;
    private bool IsFund => Item?.Type.Equals("Fund", StringComparison.OrdinalIgnoreCase) == true;

    protected override void OnParametersSet()
    {
        if (Item != null && Item.Id != _lastItemId)
        {
            _lastItemId = Item.Id;
            Shares = Item.Shares;
            PurchasePrice = Item.PurchasePrice;
            PurchaseDate = Item.PurchaseDate;
            Commission = Item.Commission;
            Name = Item.Name;
            AlternativeSymbol = Item.AlternativeSymbol;
            UseAlternativeSymbol = Item.UseAlternativeSymbol;
        }
    }

    private async Task Save()
    {
        if (Item == null || Shares <= 0 || PurchasePrice <= 0)
        {
            HasError = true;
            ErrorMessage = "Please fill all required fields.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Name))
        {
            HasError = true;
            ErrorMessage = "Name is required.";
            return;
        }

        IsSaving = true;
        HasError = false;

        try
        {
            var request = new UpdatePortfolioItemRequest
            {
                Shares = Shares,
                PurchasePrice = PurchasePrice,
                PurchaseDate = PurchaseDate,
                Commission = Commission,
                Name = Name,
                AlternativeSymbol = AlternativeSymbol,
                UseAlternativeSymbol = UseAlternativeSymbol
            };

            var result = await ApiService.UpdateItemAsync(Item.Id, UserId, request);
            if (result != null)
            {
                await OnItemUpdated.InvokeAsync();
                await Close();
            }
            else
            {
                HasError = true;
                ErrorMessage = "Failed to update investment.";
            }
        }
        catch (Exception ex)
        {
            HasError = true;
            ErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task Close()
    {
        Shares = 0;
        PurchasePrice = 0;
        PurchaseDate = null;
        Commission = 0;
        Name = "";
        AlternativeSymbol = null;
        UseAlternativeSymbol = false;
        _lastItemId = null;
        IsSaving = false;
        HasError = false;
        ErrorMessage = "";
        await IsVisibleChanged.InvokeAsync(false);
    }
}
