@page "/"
@rendermode InteractiveServer
@inject PortfolioApiService ApiService
@inject IJSRuntime JS
@inject UserIdService UserIdService
@inject ILogger<Home> Logger

<PageTitle>My Portfolio</PageTitle>

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 fw-bold">Dashboard</h1>
            <p class="text-muted mb-0 small">Resumen de tu cartera</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn pt-nav-btn" @onclick='() => showTransferDialog = true'>
                <span class="oi oi-loop-square"></span>
                <span class="d-none d-sm-inline">Traspaso</span>
            </button>
            <button class="btn btn-primary" @onclick="ShowAddDialog">
                <span class="oi oi-plus"></span>
                Añadir inversión
            </button>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
            <p class="mt-3 text-muted">Cargando cartera...</p>
        </div>
    }
    else if (PortfolioItems.Count == 0)
    {
        <div class="pt-empty-state">
            <div class="pt-empty-state-icon">
                <span class="oi oi-bar-chart"></span>
            </div>
            <h4 class="h5 mb-2">Tu cartera está vacía</h4>
            <p class="text-muted mb-4">Empieza añadiendo tu primera inversión para ver el rendimiento.</p>
            <button class="btn btn-primary btn-lg" @onclick="ShowAddDialog">
                <span class="oi oi-plus me-1"></span>
                Añadir primera inversión
            </button>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-xl-3 col-md-6">
                <div class="pt-kpi-card h-100">
                    <div class="pt-kpi-label">Valor total</div>
                    <div class="pt-kpi-value">@TotalValue.ToString("N2") €</div>
                    <div class="pt-kpi-sub">@PortfolioItems.Count posiciones</div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="pt-kpi-card h-100">
                    <div class="pt-kpi-label">Ganancia / Pérdida</div>
                    <div class="pt-kpi-value @TotalGainLossClass">@TotalGainLoss.ToString("+#,##0.00;-#,##0.00;0.00") €</div>
                    <div class="pt-kpi-sub @TotalGainLossClass">@TotalGainLossPercent.ToString("F2")%</div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="pt-kpi-card h-100">
                    <div class="pt-kpi-label">Rentabilidad anualizada</div>
                    <div class="pt-kpi-value @(DetailedPerf?.XirrSinceInceptionPct is { } xirr ? GetGainLossClass(xirr) : "text-muted")">
                        @(DetailedPerf?.XirrSinceInceptionPct is { } xirrValue ? $"{xirrValue:F2}%" : "—")
                    </div>
                    <div class="pt-kpi-sub">TIR (XIRR) desde inicio</div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="pt-kpi-card h-100">
                    <div class="pt-kpi-label">Mejor posición</div>
                    <div class="pt-kpi-value text-success">
                        @(SortedItems.Any() ? SortedItems.OrderByDescending(i => i.GainLossPercent).First().Name : "—")
                    </div>
                    <div class="pt-kpi-sub">
                        @(SortedItems.Any() ? $"{SortedItems.OrderByDescending(i => i.GainLossPercent).First().GainLossPercent:F2}%" : "")
                    </div>
                </div>
            </div>
        </div>

        @if (DetailedPerf?.Periods is { Count: > 0 })
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="pt-section-title">Rentabilidad por periodo</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3 text-center">
                        @foreach (var p in PerfPeriods)
                        {
                            <div class="col-6 col-md-4 col-lg">
                                <div class="p-2 rounded" style="background-color: var(--pt-bg);">
                                    <div class="small text-muted mb-1">@p.Label</div>
                                    @if (PeriodReturn(p) is { } periodReturn)
                                    {
                                        <div class="h5 fw-bold mb-0 @GetGainLossClass(periodReturn)">@periodReturn.ToString("+0.00;-0.00;0.00")%</div>
                                    }
                                    else
                                    {
                                        <div class="h5 text-muted mb-0">—</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="row g-4 mb-4">
            <div class="col-lg-8">
                <div class="card h-100">
                    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <h5 class="pt-section-title">@(ShowReturnChart ? "Rentabilidad acumulada" : "Evolución del valor")</h5>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <button type="button" class="btn btn-sm btn-outline-info"
                                    @onclick="() => RunBackfill(History != null && History.Total.Count >= 2)"
                                    disabled="@isBackfilling">
                                @if (isBackfilling)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                @(History != null && History.Total.Count >= 2 ? "Recalcular histórico" : "Cargar histórico 12m")
                            </button>
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-sm @(ShowReturnChart ? "btn-outline-secondary" : "btn-outline-primary active")"
                                        @onclick="() => ShowReturnChart = false">Valor</button>
                                <button type="button" class="btn btn-sm @(ShowReturnChart ? "btn-outline-primary active" : "btn-outline-secondary")"
                                        @onclick="() => ShowReturnChart = true">Rentabilidad</button>
                            </div>
                            <div class="btn-group" role="group">
                                @foreach (var period in Periods)
                                {
                                    <button type="button" class="btn pt-period-btn @(SelectedPeriod == period.Key ? "active" : "btn-outline-secondary")"
                                            @onclick="() => SelectPeriod(period.Key)">
                                        @(period.Key == "ytd" ? YtdLabel : period.Label)
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (History != null)
                        {
                            <div class="d-flex align-items-center gap-3 mb-4">
                                @if (ShowReturnChart)
                                {
                                    <span class="display-5 fw-bold lh-1 @GetGainLossClass(PeriodChangePercent)">
                                        @(ActiveChartPoints.Count >= 2 ? $"{PeriodChangePercent.ToString("+0.00;-0.00;0.00")}%" : "—")
                                    </span>
                                    <div class="small">
                                        <div class="fw-semibold">@PerfLabelForPeriod en el periodo</div>
                                        <div class="text-muted">
                                            @(ActiveChartPoints.Count >= 2
                                                ? (IsFullHistoryWindow
                                                    ? "Rentabilidad simple desde inicio (ganancia ÷ invertido)"
                                                    : "Rentabilidad TWR (sin efecto de aportaciones)")
                                                : "Sin datos")
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="display-5 fw-bold lh-1 @GetGainLossClass(PeriodChangeEur)">
                                        @(ActiveChartPoints.Count >= 2 ? $"{PeriodChangeEur.ToString("+#,##0.00;-#,##0.00;0.00")} €" : "—")
                                    </span>
                                    <div class="small">
                                        <div class="fw-semibold">@PerfLabelForPeriod en el periodo</div>
                                        <div class="text-muted">
                                            @(ActiveChartPoints.Count >= 2 ? "Cambio de valor (aportaciones incluidas)" : "Sin datos")
                                        </div>
                                    </div>
                                }
                                <span class="ms-auto text-muted small">@PeriodRangeText</span>
                            </div>

                            @if (SelectedPeriod == "1d")
                            {
                                <p class="text-muted small mb-0">
                                    Desglose diario por posición en la columna <strong>Hoy</strong> de la tabla inferior.
                                </p>
                            }
                            else
                            {
                                <PortfolioChart Points="ActiveChartPoints" IsReturn="ShowReturnChart" />
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-5">
                                <span class="oi oi-graph" style="font-size: 2rem;"></span>
                                <p class="mt-2 mb-0">No hay datos históricos disponibles.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <AllocationChart Items="PortfolioItems" />
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="pt-section-title">Posiciones</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th><span role="button" class="user-select-none" style="cursor:pointer" @onclick='() => ToggleSort("Name")'>Posición @SortIcon("Name")</span></th>
                                <th class="text-end"><span role="button" class="user-select-none" style="cursor:pointer" @onclick='() => ToggleSort("CurrentValue")'>Valor actual @SortIcon("CurrentValue")</span></th>
                                <th class="text-end">Hoy</th>
                                <th class="text-end"><span role="button" class="user-select-none" style="cursor:pointer" @onclick='() => ToggleSort("GainLoss")'>Ganancia @SortIcon("GainLoss")</span></th>
                                <th class="text-end"><span role="button" class="user-select-none" style="cursor:pointer" @onclick='() => ToggleSort("GainLossPercent")'>Ganancia % @SortIcon("GainLossPercent")</span></th>
                                <th class="text-end" style="width: 60px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in SortedItems)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded d-flex align-items-center justify-content-center" style="width: 2.25rem; height: 2.25rem; background-color: var(--pt-primary-subtle); color: var(--pt-primary);">
                                                <span class="oi oi-graph" style="font-size: 0.875rem;"></span>
                                            </div>
                                            <div>
                                                <div class="fw-semibold">@item.Name</div>
                                                <div class="small text-muted">
                                                    @item.Symbol
                                                    @if (item.UseAlternativeSymbol)
                                                    {
                                                        <span class="badge bg-info ms-1" title="Usando símbolo alternativo @item.AlternativeSymbol">A</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    @if (item.PriceAvailable)
                                    {
                                        var daily = DailyByItem.GetValueOrDefault(item.Id);
                                        <td class="text-end align-middle">@item.CurrentValue.ToString("N2") €</td>
                                        <td class="text-end align-middle">
                                            @if (daily != null && daily.HasData)
                                            {
                                                @if (daily.ChangePct!.Value == 0 && item.Type.Equals("Fund", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="text-muted" title="El NAV de hoy aún no se ha publicado (~20:00-22:00). Se actualizará automáticamente.">0.00%</span>
                                                    <small class="text-muted d-block">@daily.ChangeEur!.Value.ToString("+#,##0.00;-#,##0.00;0.00") €</small>
                                                }
                                                else
                                                {
                                                    <span class="fw-bold @GetGainLossClass(daily.ChangePct!.Value)">@daily.ChangePct.Value.ToString("+0.00;-0.00;0.00")%</span>
                                                    <small class="text-muted d-block">@daily.ChangeEur!.Value.ToString("+#,##0.00;-#,##0.00;0.00") €</small>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-end align-middle @GetGainLossClass(item.GainLoss)">@item.GainLoss.ToString("N2") €</td>
                                        <td class="text-end align-middle @GetGainLossClass(item.GainLossPercent)">@item.GainLossPercent.ToString("F2")%</td>
                                    }
                                    else
                                    {
                                        <td class="text-end align-middle text-muted">@item.CurrentValue.ToString("N2") €</td>
                                        <td class="text-end align-middle text-muted" colspan="3" title="Price unavailable: no provider returned a price for this symbol.">
                                            N/A <span class="badge bg-warning text-dark ms-1">no price</span>
                                        </td>
                                    }
                                    <td class="text-end align-middle">
                                        <div class="dropdown pt-action-menu">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <span class="oi oi-menu"></span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                                <li><button class="dropdown-item" @onclick="() => ShowDetail(item)"><span class="oi oi-graph me-2"></span>Ver evolución</button></li>
                                                <li><button class="dropdown-item" @onclick="() => ShowAddToExistingDialog(item)"><span class="oi oi-plus me-2"></span>Añadir compra</button></li>
                                                <li><button class="dropdown-item" @onclick="() => ShowSafeBackDialog(item)"><span class="oi oi-loop-circular me-2"></span>SafeBack</button></li>
                                                <li><button class="dropdown-item" @onclick="() => ShowEditDialog(item)"><span class="oi oi-pencil me-2"></span>Editar</button></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li><button class="dropdown-item text-danger" @onclick="() => ConfirmDelete(item)"><span class="oi oi-trash me-2"></span>Eliminar</button></li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<AddItemDialog 
    @bind-IsVisible="showAddDialog" 
    UserId="UserIdService.UserId"
    ExistingItems="PortfolioItems"
    PreselectedExistingItemId="addToExistingItemId"
    OnItemAdded="RefreshPortfolio" />

<SafeBackDialog
    @bind-IsVisible="showSafeBackDialog"
    UserId="UserIdService.UserId"
    Item="safeBackItem"
    OnSafeBackAdded="RefreshPortfolio" />

<EditItemDialog 
    @bind-IsVisible="showEditDialog" 
    Item="selectedItem" 
    UserId="UserIdService.UserId" 
    OnItemUpdated="RefreshPortfolio" />

<TransferDialog
    @bind-IsVisible="showTransferDialog"
    UserId="UserIdService.UserId"
    Items="PortfolioItems"
    OnTransferred="RefreshPortfolio" />

@if (showDetailModal && detailItem != null)
{
    var series = History != null && History.Items.TryGetValue(detailItem.Id.ToString(), out var s)
        ? s
        : new List<HistoryPointDto>();
    var returnSeries = History != null && History.ItemReturns.TryGetValue(detailItem.Id.ToString(), out var r)
        ? r
        : new List<HistoryPointDto>();
    var activeDetailSeries = detailShowReturn ? returnSeries : series;
    var weight = TotalValue > 0 ? detailItem.CurrentValue / TotalValue * 100 : 0;
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="detailModalTitle" style="background-color: rgba(0,0,0,0.7);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="detailModalTitle">
                        @detailItem.Name
                        <small class="text-muted fw-normal">(@detailItem.Symbol)</small>
                    </h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CloseDetail"></button>
                </div>
                <div class="modal-body">
                    <div class="text-muted small mb-3">
                        Precio actual:
                        @if (detailItem.PriceAvailable)
                        {
                            <text>$@detailItem.CurrentPriceUsd.ToString("N4") · @detailItem.CurrentPrice.ToString("N4") €</text>
                        }
                        else
                        {
                            <text>N/A</text>
                        }
                        @if (!string.IsNullOrEmpty(detailItem.AlternativeSymbol))
                        {
                            <span class="ms-2">ISIN EOD: @detailItem.AlternativeSymbol</span>
                        }
                    </div>
                    <div class="row text-center mb-3 g-3">
                        <div class="col-6 col-md">
                            <small class="text-muted d-block">Valor actual</small>
                            <span class="fw-bold">@(detailItem.PriceAvailable ? detailItem.CurrentValue.ToString("N2") + " €" : "N/A")</span>
                        </div>
                        <div class="col-6 col-md">
                            <small class="text-muted d-block">Peso en cartera</small>
                            <span class="fw-bold">@weight.ToString("F1")%</span>
                        </div>
                        <div class="col-6 col-md">
                            <small class="text-muted d-block">Ganancia</small>
                            <span class="fw-bold @GetGainLossClass(detailItem.GainLoss)">
                                @(detailItem.PriceAvailable ? $"{detailItem.GainLoss:N2} € ({detailItem.GainLossPercent:F2}%)" : "N/A")
                            </span>
                        </div>
                        <div class="col-6 col-md">
                            <small class="text-muted d-block">Participaciones</small>
                            <span class="fw-bold">@detailItem.Shares.ToString("N4")</span>
                        </div>
                        <div class="col-6 col-md">
                            <small class="text-muted d-block">Precio medio</small>
                            <span class="fw-bold">@detailItem.PurchasePrice.ToString("N4") €</span>
                        </div>
                        @if (detailItem.SafeBackAmount > 0)
                        {
                            <div class="col-6 col-md">
                                <small class="text-muted d-block">SafeBack acumulado</small>
                                <span class="fw-bold text-info">@detailItem.SafeBackAmount.ToString("N2") €</span>
                            </div>
                        }
                    </div>
                    <div class="d-flex justify-content-end mb-3">
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-sm @(detailShowReturn ? "btn-outline-secondary" : "btn-outline-primary active")"
                                    @onclick="() => detailShowReturn = false">Valor</button>
                            <button type="button" class="btn btn-sm @(detailShowReturn ? "btn-outline-primary active" : "btn-outline-secondary")"
                                    @onclick="() => detailShowReturn = true">Rentabilidad</button>
                        </div>
                    </div>
                    <PortfolioChart Points="activeDetailSeries" IsReturn="detailShowReturn" />

                    <h6 class="mt-4 mb-2">Operaciones</h6>
                    @if (itemTransactions.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-striped mb-0">
                                <thead>
                                    <tr>
                                        <th>Fecha</th><th>Tipo</th><th class="text-end">Participaciones</th><th class="text-end">Importe</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tx in itemTransactions)
                                    {
                                        <tr>
                                            <td>@tx.Date.ToString("dd/MM/yyyy")</td>
                                            <td>@TxTypeLabel(tx.Type)</td>
                                            <td class="text-end">@tx.Shares.ToString("N4")</td>
                                            <td class="text-end">@tx.AmountEur.ToString("N2") €</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Sin operaciones registradas.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDetail">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteConfirm && itemToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle" style="background-color: rgba(0,0,0,0.7);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalTitle">Eliminar inversión</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>¿Seguro que quieres eliminar <strong>@itemToDelete.Symbol</strong> de tu cartera?</p>
                    <p class="text-muted small mb-0">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteItem" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <span>Eliminar</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (hasError)
{
    <div class="alert @(messageIsInfo ? "alert-info" : "alert-danger") position-fixed bottom-0 end-0 m-3 pt-toast" style="z-index: 9999;">
        <div class="d-flex align-items-center gap-2">
            <span>@errorMessage</span>
            <button type="button" class="btn-close" @onclick="DismissError"></button>
        </div>
    </div>
}

@code {
    private List<PortfolioItemDto> PortfolioItems { get; set; } = [];
    private PortfolioPerformanceDto? Performance { get; set; }
    private PortfolioHistoryResponseDto? History { get; set; }
    private string SelectedPeriod { get; set; } = "1d";
    private bool ShowReturnChart { get; set; } = true;
    private bool IsLoading { get; set; } = true;
    private bool showAddDialog { get; set; } = false;
    private bool showEditDialog { get; set; } = false;
    private PortfolioItemDto? selectedItem;
    private bool showDeleteConfirm { get; set; } = false;
    private PortfolioItemDto? itemToDelete;
    private bool isDeleting;

    private PortfolioItemDto? detailItem;
    private bool showDetailModal { get; set; } = false;
    private bool detailShowReturn { get; set; }
    private bool isBackfilling = false;
    private bool showTransferDialog { get; set; } = false;
    private DetailedPerformanceDto? DetailedPerf { get; set; }
    private List<PeriodPerformanceDto> PerfPeriods => DetailedPerf?.Periods ?? [];
    private List<TransactionDto> itemTransactions { get; set; } = [];
    private bool showSafeBackDialog { get; set; } = false;
    private PortfolioItemDto? safeBackItem;
    private Guid? addToExistingItemId;

    private static string TxTypeLabel(string type) => type switch
    {
        "Buy" => "Suscripción",
        "Sell" => "Reembolso",
        "TransferIn" => "Traspaso recibido",
        "TransferOut" => "Traspaso emitido",
        "SafeBack" => "SafeBack",
        _ => type
    };

    private void ShowDetail(PortfolioItemDto item)
    {
        detailItem = item;
        detailShowReturn = false;
        showDetailModal = true;
        itemTransactions = [];
        _ = LoadItemTransactionsAsync(item.Id);
    }

    private async Task LoadItemTransactionsAsync(Guid itemId)
    {
        try
        {
            var txs = await ApiService.GetItemTransactionsAsync(UserIdService.UserId, itemId);
            if (detailItem?.Id == itemId)
            {
                itemTransactions = txs;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load transactions for item {ItemId}", itemId);
        }
    }

    private void CloseDetail()
    {
        detailItem = null;
        showDetailModal = false;
    }

    private async Task RunBackfill(bool rebuild)
    {
        isBackfilling = true;
        try
        {
            var result = await ApiService.BackfillHistoryAsync(UserIdService.UserId, rebuild);
            if (result != null)
            {
                var ok = result.Items.Count(i => i.Status == "ok" || i.Status == "up-to-date");
                var failed = result.Items.Count - ok;
                History = await ApiService.GetHistoryAsync(UserIdService.UserId);
                ShowInfo($"Histórico: {result.TotalPointsInserted} puntos insertados ({ok} símbolos OK{(failed > 0 ? $", {failed} con error" : "")}).");
            }
            else
            {
                ShowError("No se pudo cargar el histórico.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Backfill failed");
            ShowError("No se pudo cargar el histórico.");
        }
        finally
        {
            isBackfilling = false;
        }
    }
    private bool hasError = false;
    private string errorMessage = "";
    private bool messageIsInfo = false;

    private string sortColumn { get; set; } = "CurrentValue";
    private bool sortAsc { get; set; } = false;

    private List<PortfolioItemDto> SortedItems
    {
        get
        {
            if (string.IsNullOrEmpty(sortColumn) || PortfolioItems.Count == 0)
                return PortfolioItems;

            IOrderedEnumerable<PortfolioItemDto> ordered = sortColumn switch
            {
                "Symbol" => Sort(i => i.Symbol),
                "Name" => Sort(i => i.Name),
                "Shares" => Sort(i => i.Shares),
                "PurchasePrice" => Sort(i => i.PurchasePrice),
                "CurrentPriceUsd" => SortPriced(i => i.CurrentPriceUsd),
                "CurrentPrice" => SortPriced(i => i.CurrentPrice),
                "CurrentValue" => SortPriced(i => i.CurrentValue),
                "GainLoss" => SortPriced(i => i.GainLoss),
                "GainLossPercent" => SortPriced(i => i.GainLossPercent),
                _ => PortfolioItems.OrderBy(_ => 0)
            };

            return ordered.ToList();
        }
    }

    // Items without a live price always sink to the bottom, regardless of direction.
    private IOrderedEnumerable<PortfolioItemDto> SortPriced(Func<PortfolioItemDto, decimal> key)
    {
        var ordered = PortfolioItems.OrderBy(i => i.PriceAvailable ? 0 : 1);
        return sortAsc ? ordered.ThenBy(key) : ordered.ThenByDescending(key);
    }

    private IOrderedEnumerable<PortfolioItemDto> Sort<T>(Func<PortfolioItemDto, T> key)
        => sortAsc ? PortfolioItems.OrderBy(key) : PortfolioItems.OrderByDescending(key);

    private void ToggleSort(string column)
    {
        if (sortColumn == column)
        {
            sortAsc = !sortAsc;
            return;
        }
        sortColumn = column;
        sortAsc = column is "Symbol" or "Name";
    }

    private MarkupString SortIcon(string column)
        => sortColumn != column ? new MarkupString("") : new MarkupString($"<i class=\"oi oi-caret-{(sortAsc ? "top" : "bottom")}\" style=\"font-size:10px\"></i>");

    private static readonly (string Key, string Label)[] Periods =
    [
        ("1d", "1D"), ("7d", "1S"), ("1m", "1M"), ("3m", "3M"), ("6m", "6M"), ("ytd", "YTD"), ("1y", "1A")
    ];

    private List<HistoryPointDto> FilteredTotalPoints => FilterSeries(History?.Total, SelectedPeriod);
    private List<HistoryPointDto> FilteredReturnPoints => FilterSeries(History?.TotalReturn, SelectedPeriod);
    private List<HistoryPointDto> FilteredSimpleReturnPoints => FilterSeries(History?.TotalSimpleReturn, SelectedPeriod);

    // True when the selected window reaches back to the very first history point.
    // In that case "rentabilidad" must be the simple since-inception return (the same
    // figure as the "Ganancia / Pérdida" KPI), not the TWR, so the two never disagree.
    private bool IsFullHistoryWindow
    {
        get
        {
            if (SelectedPeriod is not ("ytd" or "1y"))
                return false;

            var all = History?.Total;
            if (all == null || all.Count == 0)
                return false;

            var first = all.OrderBy(p => p.Date).First().Date;
            var cutoff = SelectedPeriod == "ytd"
                ? new DateTime(DateTime.UtcNow.Year, 1, 1)
                : DateTime.UtcNow.Date.AddDays(-365);
            return first >= cutoff;
        }
    }

    private List<HistoryPointDto> ActiveChartPoints => ShowReturnChart
        ? (IsFullHistoryWindow ? FilteredSimpleReturnPoints : FilteredReturnPoints)
        : FilteredTotalPoints;

    private static List<HistoryPointDto> FilterSeries(List<HistoryPointDto>? series, string period)
    {
        if (series == null || series.Count == 0)
            return [];

        var sorted = series.OrderBy(p => p.Date).ToList();

        // 1D = latest point vs the previous available day (weekend/NAV lag included),
        // never the "not enough data" placeholder.
        if (period == "1d")
            return sorted.Count == 1 ? [sorted[^1]] : [sorted[^2], sorted[^1]];

        var cutoff = period switch
        {
            "7d" => DateTime.UtcNow.Date.AddDays(-7),
            "1m" => DateTime.UtcNow.Date.AddDays(-30),
            "3m" => DateTime.UtcNow.Date.AddDays(-90),
            "6m" => DateTime.UtcNow.Date.AddDays(-180),
            "ytd" => new DateTime(DateTime.UtcNow.Year, 1, 1),
            "1y" => DateTime.UtcNow.Date.AddDays(-365),
            _ => DateTime.MinValue
        };
        return sorted.Where(p => p.Date >= cutoff).ToList();
    }

    // Compounds the TWR points of a window; shared by the chart headline and the
    // "Rentabilidad por periodo" cards so both always show the same number.
    private static decimal ComputeSeriesWindowReturn(List<HistoryPointDto> pts)
    {
        var start = pts[0].Value;
        var end = pts[^1].Value;
        if (start <= -100m)
            return 0m;
        return decimal.Round(((1 + end / 100m) / (1 + start / 100m) - 1) * 100m, 2);
    }

    private decimal PeriodChangePercent
    {
        get
        {
            var pts = ActiveChartPoints;
            if (pts.Count == 0)
                return 0;

            if (ShowReturnChart)
            {
                // A full-history window is the same figure as the Gain/Loss KPI; the
                // TWR is only meaningful for bounded windows where it removes the
                // distorting effect of contributions made inside the period.
                if (IsFullHistoryWindow)
                    return TotalGainLossPercent;

                // TWR is stored as cumulative percentage; compute the sub-period return
                // by compounding from the first to the last point of the filtered window.
                return ComputeSeriesWindowReturn(pts);
            }

            if (pts[0].Value == 0)
                return 0;
            return (pts[^1].Value - pts[0].Value) / pts[0].Value * 100;
        }
    }

    private decimal PeriodChangeEur
    {
        get
        {
            var pts = ActiveChartPoints;
            return pts.Count >= 2 ? pts[^1].Value - pts[0].Value : 0;
        }
    }

    // While the whole history lives inside the current calendar year there is no
    // calendar-YTD to show: the button means "since inception" instead.
    private string YtdLabel
    {
        get
        {
            var firstDate = History?.Total.OrderBy(p => p.Date).FirstOrDefault()?.Date;
            return firstDate.HasValue && firstDate.Value < new DateTime(DateTime.UtcNow.Year, 1, 1)
                ? "YTD"
                : "Inicio";
        }
    }

    private string PerfLabelForPeriod
    {
        get
        {
            var label = Periods.First(p => p.Key == SelectedPeriod).Label;
            if (SelectedPeriod == "ytd")
                label = YtdLabel;
            return label + (SelectedPeriod == "1d" ? " (vs último día disponible)" : "");
        }
    }

    private sealed record DailyPositionChange(string Name, string Symbol, decimal Value, bool HasData, decimal? ChangeEur, decimal? ChangePct);

    // Per-position daily change from the stored per-item history series,
    // consumed by the "Hoy" column of the main table.
    private Dictionary<Guid, DailyPositionChange> DailyByItem
    {
        get
        {
            var dict = new Dictionary<Guid, DailyPositionChange>();
            if (History == null || PortfolioItems.Count == 0)
                return dict;

            foreach (var item in PortfolioItems)
            {
                if (!History.Items.TryGetValue(item.Id.ToString(), out var pts) || pts.Count < 2)
                {
                    dict[item.Id] = new DailyPositionChange(item.Name, item.Symbol, item.CurrentValue, false, null, null);
                    continue;
                }

                var sorted = pts.OrderBy(p => p.Date).ToList();
                var prev = sorted[^2].Value;
                var last = sorted[^1].Value;
                var change = last - prev;
                dict[item.Id] = new DailyPositionChange(
                    item.Name,
                    item.Symbol,
                    last,
                    true,
                    change,
                    prev != 0 ? change / prev * 100m : 0m);
            }

            return dict;
        }
    }

    private string PeriodRangeText
    {
        get
        {
            var pts = ActiveChartPoints;
            if (pts.Count == 0)
                return "Sin datos";
            var label = Periods.First(p => p.Key == SelectedPeriod).Label;
            return $"{pts.Count} valor(es) diarios - periodo {label}";
        }
    }

    private void SelectPeriod(string key) => SelectedPeriod = key;

    private decimal TotalValue => PortfolioItems.Sum(p => p.CurrentValue);
    private decimal TotalGainLoss => PortfolioItems.Sum(p => p.GainLoss);

    // Single source of truth computed server-side (PortfolioService.ComputeSinceInception):
    // both this KPI and the "Desde inicio" period card read the same value.
    private decimal TotalGainLossPercent => Performance?.SinceInceptionGainLossPercent ?? 0;

    // "Desde inicio" is exactly the since-inception KPI; bounded windows compound the
    // same TWR series the chart plots, so the period card and the chart never disagree.
    private decimal? PeriodReturn(PeriodPerformanceDto period)
    {
        if (period.Label.StartsWith("Desde inicio"))
            return TotalGainLossPercent;

        var pts = FilterSeries(History?.TotalReturn, period.Key);
        return pts.Count >= 2 ? ComputeSeriesWindowReturn(pts) : null;
    }

    private string TotalGainLossClass => GetGainLossClass(TotalGainLoss);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshPortfolio();
            await InvokeAsync(StateHasChanged);
        }
    }

    // Serializes refreshes: overlapping calls (dialog callbacks, backfill, renders)
    // must not race and let the slowest response win.
    private readonly SemaphoreSlim _refreshLock = new(1, 1);

    private async Task RefreshPortfolio()
    {
        if (UserIdService.UserId == Guid.Empty)
            return;

        await _refreshLock.WaitAsync();
        IsLoading = true;
        try
        {
            Logger.LogInformation("Fetching dashboard for user {UserId}", UserIdService.UserId);
            var dashboard = await ApiService.GetDashboardAsync(UserIdService.UserId);
            if (dashboard != null)
            {
                PortfolioItems = dashboard.Items;
                Performance = dashboard.Performance;
                Logger.LogInformation("Dashboard loaded: {Count} items", PortfolioItems.Count);

                History = await ApiService.GetHistoryAsync(UserIdService.UserId);
                DetailedPerf = await ApiService.GetDetailedPerformanceAsync(UserIdService.UserId);
            }
            else
            {
                PortfolioItems = [];
                Performance = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading portfolio");
            ShowError("No se pudo cargar la cartera. Inténtalo de nuevo.");
            PortfolioItems = [];
        }
        finally
        {
            IsLoading = false;
            _refreshLock.Release();
        }
    }

