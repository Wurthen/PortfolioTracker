@page "/"
@rendermode InteractiveServer
@inject PortfolioApiService ApiService
@inject IJSRuntime JS
@inject UserIdService UserIdService
@inject ILogger<Home> Logger

<PageTitle>My Portfolio</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">My Portfolio</h1>
        <button class="btn btn-primary" @onclick="ShowAddDialog">
            <span class="oi oi-plus me-1"></span>
            Add Investment
        </button>
    </div>

    @if (IsLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Loading...</p>
        </div>
    }
    else if (PortfolioItems.Count == 0)
    {
        <div class="text-center py-5 bg-light rounded">
            <p class="text-muted mb-3">Your portfolio is empty</p>
            <button class="btn btn-primary" @onclick="ShowAddDialog">Add your first investment</button>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-8">
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <small class="text-muted">Total Value</small>
                                <div class="h4 mb-0 text-success">@TotalValue.ToString("N2") €</div>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted">Total Gain/Loss</small>
                                <div class="h4 mb-0 @TotalGainLossClass">@TotalGainLoss.ToString("N2") €</div>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted">Total Gain/Loss %</small>
                                <div class="h4 mb-0 @TotalGainLossClass">@TotalGainLossPercent.ToString("F2")%</div>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted">Investments</small>
                                <div class="h4 mb-0">@PortfolioItems.Count</div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Performance != null)
                {
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Performance</h5>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col">
                                    <small class="text-muted d-block">1 Day</small>
                                    <span class="fw-bold @GetGainLossClass(Performance.Daily)">@Performance.Daily.ToString("F2")%</span>
                                </div>
                                <div class="col">
                                    <small class="text-muted d-block">1 Week</small>
                                    <span class="fw-bold @GetGainLossClass(Performance.Weekly)">@Performance.Weekly.ToString("F2")%</span>
                                </div>
                                <div class="col">
                                    <small class="text-muted d-block">1 Month</small>
                                    <span class="fw-bold @GetGainLossClass(Performance.Monthly)">@Performance.Monthly.ToString("F2")%</span>
                                </div>
                                <div class="col">
                                    <small class="text-muted d-block">YTD</small>
                                    <span class="fw-bold @GetGainLossClass(Performance.Ytd)">@Performance.Ytd.ToString("F2")%</span>
                                </div>
                                <div class="col">
                                    <small class="text-muted d-block">1 Year</small>
                                    <span class="fw-bold @GetGainLossClass(Performance.Yearly)">@Performance.Yearly.ToString("F2")%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="col-md-4">
                <AllocationChart Items="PortfolioItems" />
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Evoluci&oacute;n del valor</h5>
                <div class="btn-group btn-group-sm" role="group">
                    @foreach (var period in Periods)
                    {
                        <button type="button" class="btn @(SelectedPeriod == period.Key ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="() => SelectPeriod(period.Key)">
                            @period.Label
                        </button>
                    }
                </div>
            </div>
            <div class="card-body">
                @if (History != null)
                {
                    <div class="d-flex justify-content-between align-items-baseline mb-2">
                        <span class="text-muted small">@PeriodRangeText</span>
                        <span class="h5 mb-0 @GetGainLossClass(PeriodChangePercent)">
                            @PeriodChangePercent.ToString("F2")%
                            <small class="text-muted">en el periodo</small>
                        </span>
                    </div>
                    <PortfolioChart Points="FilteredTotalPoints" />
                }
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Symbol</th>
                        <th>Name</th>
                        <th class="text-end">Shares</th>
                        <th class="text-end">Purchase Price</th>
                        <th class="text-end">Current Price (USD)</th>
                        <th class="text-end">Current Price (EUR)</th>
                        <th class="text-end">Current Value</th>
                        <th class="text-end">Gain/Loss</th>
                        <th class="text-end">Gain/Loss %</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in PortfolioItems)
                    {
                        <tr>
                            <td>
                                <strong>@item.Symbol</strong>
                                @if (item.UseAlternativeSymbol)
                                {
                                    <span class="badge bg-info ms-1" title="Using alternative symbol @item.AlternativeSymbol">A</span>
                                }
                            </td>
                            <td>@item.Name</td>
                            <td class="text-end">@item.Shares.ToString("N4")</td>
                            <td class="text-end">@item.PurchasePrice.ToString("N4") €</td>
                            @if (item.PriceAvailable)
                            {
                                <td class="text-end">$@item.CurrentPriceUsd.ToString("N4")</td>
                                <td class="text-end">@item.CurrentPrice.ToString("N4") €</td>
                                <td class="text-end">@item.CurrentValue.ToString("N2") €</td>
                                <td class="text-end @GetGainLossClass(item.GainLoss)">@item.GainLoss.ToString("N2") €</td>
                                <td class="text-end @GetGainLossClass(item.GainLossPercent)">@item.GainLossPercent.ToString("F2")%</td>
                            }
                            else
                            {
                                <td class="text-end text-muted" colspan="5" title="Price unavailable: no provider returned a price for this symbol.">
                                    N/A <span class="badge bg-warning text-dark ms-1">no price</span>
                                </td>
                            }
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowEditDialog(item)">
                                    <span class="oi oi-pencil"></span>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(item)">
                                    <span class="oi oi-trash"></span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<AddItemDialog 
    @bind-IsVisible="showAddDialog" 
    UserId="UserIdService.UserId" 
    OnItemAdded="RefreshPortfolio" />

<EditItemDialog 
    @bind-IsVisible="showEditDialog" 
    Item="selectedItem" 
    UserId="UserIdService.UserId" 
    OnItemUpdated="RefreshPortfolio" />

@if (showDeleteConfirm && itemToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Investment</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>@itemToDelete.Symbol</strong> from your portfolio?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteItem" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <span>Delete</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (hasError)
{
    <div class="alert alert-danger position-fixed bottom-0 end-0 m-3" style="z-index: 9999;">
        @errorMessage
        <button type="button" class="btn-close" @onclick="DismissError"></button>
    </div>
}

@code {
    private List<PortfolioItemDto> PortfolioItems { get; set; } = [];
    private PortfolioPerformanceDto? Performance { get; set; }
    private PortfolioHistoryResponseDto? History { get; set; }
    private string SelectedPeriod { get; set; } = "1m";
    private bool IsLoading { get; set; } = true;
    private bool showAddDialog { get; set; } = false;
    private bool showEditDialog { get; set; } = false;
    private PortfolioItemDto? selectedItem;
    private bool showDeleteConfirm { get; set; } = false;
    private PortfolioItemDto? itemToDelete;
    private bool isDeleting;
    private bool hasError = false;
    private string errorMessage = "";

    private static readonly (string Key, string Label)[] Periods =
    [
        ("1d", "1D"), ("7d", "1S"), ("1m", "1M"), ("3m", "3M"), ("6m", "6M"), ("ytd", "YTD"), ("1y", "1A")
    ];

    private List<HistoryPointDto> FilteredTotalPoints
    {
        get
        {
            if (History == null)
                return [];
            var cutoff = SelectedPeriod switch
            {
                "1d" => DateTime.UtcNow.Date,
                "7d" => DateTime.UtcNow.Date.AddDays(-7),
                "1m" => DateTime.UtcNow.Date.AddDays(-30),
                "3m" => DateTime.UtcNow.Date.AddDays(-90),
                "6m" => DateTime.UtcNow.Date.AddDays(-180),
                "ytd" => new DateTime(DateTime.UtcNow.Year, 1, 1),
                "1y" => DateTime.UtcNow.Date.AddDays(-365),
                _ => DateTime.MinValue
            };
            return History.Total.Where(p => p.Date >= cutoff).ToList();
        }
    }

    private decimal PeriodChangePercent
    {
        get
        {
            var pts = FilteredTotalPoints;
            if (pts.Count == 0 || pts[0].Value == 0)
                return 0;
            return (pts[^1].Value - pts[0].Value) / pts[0].Value * 100;
        }
    }

    private string PeriodRangeText
    {
        get
        {
            var pts = FilteredTotalPoints;
            if (pts.Count == 0)
                return "Sin datos";
            var label = Periods.First(p => p.Key == SelectedPeriod).Label;
            return $"{pts.Count} valor(es) diarios - periodo {label}";
        }
    }

    private void SelectPeriod(string key) => SelectedPeriod = key;

    private decimal TotalValue => PortfolioItems.Sum(p => p.CurrentValue);
    private decimal TotalGainLoss => PortfolioItems.Sum(p => p.GainLoss);
    private decimal TotalGainLossPercent => PortfolioItems.Count > 0 ? (TotalGainLoss / (PortfolioItems.Sum(p => p.Shares * p.PurchasePrice))) * 100 : 0;

    private string TotalGainLossClass => GetGainLossClass(TotalGainLoss);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshPortfolio();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshPortfolio()
    {
        if (UserIdService.UserId == Guid.Empty)
            return;

        IsLoading = true;
        try
        {
            Logger.LogInformation("Fetching dashboard for user {UserId}", UserIdService.UserId);
            var dashboard = await ApiService.GetDashboardAsync(UserIdService.UserId);
            if (dashboard != null)
            {
                PortfolioItems = dashboard.Items;
                Performance = dashboard.Performance;
                Logger.LogInformation("Dashboard loaded: {Count} items", PortfolioItems.Count);

                History = await ApiService.GetHistoryAsync(UserIdService.UserId);
            }
            else
            {
                PortfolioItems = [];
                Performance = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading portfolio");
            ShowError($"Error loading portfolio: {ex.Message}");
            PortfolioItems = [];
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ShowAddDialog()
    {
        Logger.LogInformation("ShowAddDialog called");
        showAddDialog = true;
    }

    private void ShowEditDialog(PortfolioItemDto item)
    {
        Logger.LogInformation("ShowEditDialog called for {Symbol}", item.Symbol);
        selectedItem = item;
        showEditDialog = true;
    }

    private void ConfirmDelete(PortfolioItemDto item)
    {
        Logger.LogInformation("ConfirmDelete called for {Symbol}", item.Symbol);
        itemToDelete = item;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        itemToDelete = null;
        showDeleteConfirm = false;
    }

    private async Task DeleteItem()
    {
        if (itemToDelete == null) return;

        isDeleting = true;
        try
        {
            await ApiService.DeleteItemAsync(itemToDelete.Id, UserIdService.UserId);
            await RefreshPortfolio();
            CancelDelete();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting item");
            ShowError($"Error deleting: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void ShowError(string message)
    {
        errorMessage = message;
        hasError = true;
    }

    private void DismissError()
    {
        hasError = false;
        errorMessage = "";
    }

    private static string GetGainLossClass(decimal value) => value switch
    {
        > 0 => "text-success",
        < 0 => "text-danger",
        _ => "text-muted"
    };
}
