    {
        Logger.LogInformation("ConfirmDelete called for {Symbol}", item.Symbol);
        itemToDelete = item;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        itemToDelete = null;
        showDeleteConfirm = false;
    }

    private async Task DeleteItem()
    {
        if (itemToDelete == null) return;

        isDeleting = true;
        try
        {
            var deleted = await ApiService.DeleteItemAsync(itemToDelete.Id, UserIdService.UserId);
            if (!deleted)
            {
                Logger.LogWarning("Delete failed for item {ItemId}", itemToDelete.Id);
                ShowError("No se pudo eliminar la inversión.");
                return;
            }

            await RefreshPortfolio();
            CancelDelete();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting item");
            ShowError("No se pudo eliminar la inversión.");
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void ShowError(string message)
    {
        errorMessage = message;
        messageIsInfo = false;
        hasError = true;
    }

    private void ShowInfo(string message)
    {
        errorMessage = message;
        messageIsInfo = true;
        hasError = true;
    }

    private void DismissError()
    {
        hasError = false;
        errorMessage = "";
    }

    private static string GetGainLossClass(decimal value) => value switch
    {
        > 0 => "text-success",
        < 0 => "text-danger",
        _ => "text-muted"
    };
