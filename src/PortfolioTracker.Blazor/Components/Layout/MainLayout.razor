@inherits LayoutComponentBase
@inject ILogger<MainLayout> Logger

<div class="page">
    <header class="pt-header">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-4">
                <a href="/" class="pt-brand text-decoration-none">
                    <span class="pt-brand-mark">PT</span>
                    <span>Portfolio Tracker</span>
                </a>
                <PortfolioSelector OnSelectionChanged="OnPortfolioSelectionChanged" />
            </div>
            <div class="d-flex align-items-center gap-3">
                <ImportButton OnImportRequested="ShowImportPlaceholder" />
                <div class="d-flex align-items-center gap-2 px-2 py-1 rounded" style="background-color: var(--pt-bg); border: 1px solid var(--pt-border);">
                    <span class="oi oi-person text-muted"></span>
                    <span class="small text-muted">Dev user</span>
                </div>
            </div>
        </div>
    </header>

    <main>
        <article class="content px-4 py-4">
            @Body
        </article>
    </main>
</div>

<ImportDialog @bind-IsVisible="showImportDialog" ImportType="@importType" />

<div id="blazor-error-ui" data-nosnippet>
    Se ha producido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool showImportDialog = false;
    private string importType = "csv";

    private void ShowImportPlaceholder(string type)
    {
        importType = type;
        showImportDialog = true;
    }

    private void OnPortfolioSelectionChanged(string portfolio)
    {
        // Multi-portfolio support is not implemented yet; only "default" exists.
        Logger.LogInformation("Portfolio selection changed to {Portfolio}", portfolio);
    }
}
